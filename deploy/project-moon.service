[Unit]
Description=project-moon MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/project-moon
EnvironmentFile=/etc/project-moon.env
ExecStart=/usr/bin/node /opt/project-moon/dist/src/server.js
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=20
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
