{
  "schemaVersion": 1,
  "validation": {
    "profileOrder": [
      "fast",
      "normal",
      "release"
    ],
    "profiles": {
      "fast": [
        "npm run check:architecture",
        "npm run typecheck"
      ],
      "normal": [
        "npm run check:architecture",
        "npm run typecheck",
        "npm test"
      ],
      "release": [
        "npm run check:architecture",
        "npm run typecheck",
        "npm test",
        "npm run build"
      ]
    },
    "riskProfiles": {
      "low": "fast",
      "medium": "normal",
      "high": "release"
    }
  },
  "risk": {
    "highPathPatterns": [
      "^src/(auth|oauth|http-server)\\.ts$",
      "^src/task/task-service\\.ts$",
      "^(deploy|tunneling)/",
      "^(Start-PublicMcp|Stop-PublicMcp|Get-OAuthApprovalKey)\\.ps1$",
      "^\\.github/workflows/"
    ],
    "mediumPathPatterns": [
      "^src/",
      "^test/",
      "^package(-lock)?\\.json$",
      "^tsconfig\\.json$",
      "^moon\\.config\\.json$"
    ],
    "highKeywords": [
      "auth",
      "oauth",
      "token",
      "secret",
      "security",
      "permission",
      "deploy",
      "production",
      "migration",
      "database",
      "network",
      "delete",
      "인증",
      "권한",
      "배포",
      "마이그레이션",
      "보안",
      "네트워크",
      "삭제"
    ],
    "mediumKeywords": [
      "api",
      "dependency",
      "refactor",
      "service",
      "schema",
      "feature",
      "기능",
      "리팩터링",
      "의존성",
      "스키마"
    ]
  },
  "architecture": {
    "layers": [
      {
        "name": "task_transport",
        "patterns": [
          "^src/task/task-tools\\.ts$"
        ]
      },
      {
        "name": "task_application",
        "patterns": [
          "^src/task/task-service\\.ts$"
        ]
      },
      {
        "name": "task_policy",
        "patterns": [
          "^src/task/(task-config|task-risk)\\.ts$"
        ]
      },
      {
        "name": "task_infrastructure",
        "patterns": [
          "^src/task/(task-repository|task-store|task-validation)\\.ts$"
        ]
      }
    ],
    "deny": [
      {
        "from": "task_application",
        "to": "task_transport"
      },
      {
        "from": "task_policy",
        "to": "task_application"
      },
      {
        "from": "task_policy",
        "to": "task_transport"
      },
      {
        "from": "task_infrastructure",
        "to": "task_application"
      },
      {
        "from": "task_infrastructure",
        "to": "task_transport"
      }
    ],
    "maxFileLines": [
      {
        "pattern": "^src/task/task-service\\.ts$",
        "max": 400
      },
      {
        "pattern": "^src/task/task-tools\\.ts$",
        "max": 200
      },
      {
        "pattern": "^src/task/task-repository\\.ts$",
        "max": 200
      }
    ]
  }
}
