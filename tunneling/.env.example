# Absolute host directory mounted at /shared.
SHARED_PATH=/absolute/path/to/shared

# Stable Tailscale Funnel URL for the host running this container.
# On Windows, Start-PublicMcp.ps1 discovers and writes this automatically.
MCP_PUBLIC_URL=https://project-moon.<TAILNET_NAME>.ts.net

# Optional settings.
TZ=UTC
# WORKMACHINE_IMAGE=workmachine:local
# MCP_ALLOWED_HOSTS=
# MCP_OAUTH_APPROVAL_KEY=
# MCP_AUTH_TOKEN=
