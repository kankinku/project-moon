# This file has no credentials. Keep the copied .env.local local-only.
TZ=Asia/Seoul
WORKMACHINE_IMAGE=project-moon-local:0.1.0

# Main developer runtime. Existing Moon behavior remains the default.
MCP_WORKFLOW_MODE=auto
MCP_RUNTIME_ROLE=developer
MCP_MERGE_AUDIT_ENABLED=false

# Independent merge auditor runtime.
# The host repository is mounted read-only at /audit/repo.
# Relative paths are resolved from tunneling/docker-compose.local.yml.
MERGE_AUDITOR_REPO_PATH=..
MERGE_AUDITOR_PORT=3999
# The Bearer token is stored outside /shared at
# %LOCALAPPDATA%\ProjectMoon\merge-auditor.env by the Windows helpers.
MERGE_AUDITOR_PUBLIC_URL=
MERGE_AUDITOR_ALLOWED_HOSTS=localhost,127.0.0.1

# Dedicated secondary GitHub account expected inside the auditor container.
# Authenticate this account once with: gh auth login
MCP_GITHUB_AUDITOR_LOGIN=
