# Generated by Start-PublicMcp.ps1 from this machine's stable Tailscale DNS name.
# Example: https://project-moon.example-tailnet.ts.net
MCP_PUBLIC_URL=https://project-moon.<TAILNET_NAME>.ts.net
MCP_ENDPOINT=/mcp
MCP_ALLOWED_HOSTS=project-moon.<TAILNET_NAME>.ts.net,localhost,127.0.0.1
MCP_OAUTH_ENABLED=true
MCP_ALLOW_NO_AUTH=false
